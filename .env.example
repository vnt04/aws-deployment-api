# ---------- App ----------
NODE_ENV=development
PORT=3000
# Danh sách origin được phép gọi API, phân tách bằng dấu phẩy. "*" = cho phép tất cả.
CORS_ORIGINS=*

# ---------- Database ----------
# Local: host của MySQL container (docker compose) — RDS: <instance>.xxxx.ap-southeast-1.rds.amazonaws.com
DB_HOST=127.0.0.1
# Cũng là host port mà docker compose publish — đổi nếu máy đã có MySQL chiếm 3306.
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=password
DB_NAME=aws_deployment
# Bật TLS khi kết nối RDS (RDS bắt buộc dùng SSL nếu rds.force_ssl=1)
DB_SSL=false
# Chỉ dùng cho lần chạy đầu ở local. Production luôn để false và chạy migration.
DB_SYNCHRONIZE=false
# Tự động chạy migration khi app khởi động
DB_RUN_MIGRATIONS=true

# ---------- AWS / S3 ----------
AWS_REGION=ap-southeast-1
S3_BUCKET=my-aws-deployment-bucket
# Bỏ trống khi chạy trên EC2 có IAM Role — SDK sẽ tự lấy credential từ instance metadata.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Chỉ set khi dùng S3-compatible local (MinIO / LocalStack), ví dụ http://127.0.0.1:9000
S3_ENDPOINT=
# Base URL public của file. Bỏ trống -> https://<bucket>.s3.<region>.amazonaws.com
# Set khi dùng CloudFront, ví dụ https://cdn.yourdomain.com
S3_PUBLIC_URL=

# ---------- Rate limit ----------
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
